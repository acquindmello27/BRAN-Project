# Azure AI Speech resource (create one in the Azure portal; F0 free tier is enough to start)
AZURE_SPEECH_KEY=paste-your-key-here
AZURE_SPEECH_REGION=eastus

# Optional. If set, the app asks for this PIN once (saved on the phone) before it
# will hand out Azure tokens. Set it when you deploy to the public internet so
# strangers can't run up your Azure bill.
APP_PIN=

# Optional. Port to listen on (hosting providers usually set this for you).
PORT=3000
